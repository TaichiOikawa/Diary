<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GitHub Releases から更新を確認し、APK を取得するために使う -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 取得した APK をシステムのインストーラーに渡すために使う -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DiaryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diary">
        <!--
            windowSoftInputMode を明示しないと、OS はこのウィンドウを ADJUST_PAN と解釈する。
            すると編集画面でキーボードを出したとき、アプリ自身が imePadding で空けた余白に加えて
            OS がウィンドウごと押し上げるため、ツールバーとキーボードの間に余白が残る。
            この余白は画面を作り直すまで消えない。
            キーボードの高さはインセットだけを見て決めたいので adjustResize を明示する。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Diary"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ダウンロードした APK はアプリのキャッシュにあるため、
            そのままの file:// URI ではインストーラーから読めない。
            FileProvider 経由の content:// URI にして一時的な読み取り権限を渡す。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>